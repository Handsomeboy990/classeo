# PostgreSQL connection string. Local Docker: see docker-compose.yml.
# Neon: use the pooled connection string of your project.
DATABASE_URL="postgresql://classeo:classeo@localhost:55432/classeo"
# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=""

# Public address of the platform, used for the links inside e-mails.
APP_URL="http://localhost:3000"

# E-mail. Leave SMTP_HOST empty to send nothing: each e-mail is then only
# summarised in the server log (recipient masked, never the content).
# Local development with Mailpit (docker compose up -d mailpit, web UI on
# http://localhost:8025):
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
# Production: your provider's SMTP relay, port 587 (STARTTLS) or 465 with
# SMTP_SECURE=true.
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
MAIL_FROM="Classéo <no-reply@classeo.bj>"

# Web push notifications (VAPID). Leave empty to keep notifications in the
# app only. Generate a pair once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact of the operator, given to the push services: mailto: or https://
VAPID_SUBJECT=""

# Online payment of school fees (FedaPay, Benin aggregator: MTN MoMo, Moov
# Money, Celtiis Cash, cards). Leave the secret key empty to hide the online
# button: parents then declare transfers to the school's accounts, which the
# accountant confirms. Keys come from the FedaPay dashboard (sandbox first).
# The webhook to declare in the dashboard is
#   <APP_URL>/api/paiements/fedapay/webhook
# and its secret goes in FEDAPAY_WEBHOOK_SECRET. The public key is kept for a
# later Checkout.js integration; the current flow only uses the secret key.
FEDAPAY_ENV="sandbox"
FEDAPAY_SECRET_KEY=""
FEDAPAY_PUBLIC_KEY=""
FEDAPAY_WEBHOOK_SECRET=""

# French voice of Kora (read aloud): Piper, voice fr_FR-siwis-medium, the
# same on every device, synthesised by the Python function api/kora-tts.py.
# On Vercel nothing is needed: the function runs in the same deployment and
# its key is derived from SESSION_SECRET. Elsewhere, run it locally with
#   python scripts/kora-tts-local.py 8765   (venv with requirements.txt)
# and set KORA_TTS_URL=http://127.0.0.1:8765. Leave KORA_TTS_URL empty to
# read French with the voice of each browser instead. KORA_TTS_SECRET
# overrides the derived key, on both sides.
KORA_TTS_URL=""
KORA_TTS_SECRET=""

# Automation bypass secret of a Vercel preview behind Vercel Authentication:
# lets /api/voix reach the voice function of that preview. Not needed in
# production, whose domain is public.
VERCEL_AUTOMATION_BYPASS_SECRET=""

# Local languages (api229langues): live translation of the interface and of
# contents, voices in Fongbe, Yoruba and Hausa, and scripts/pretranslate.ts.
# All three must be set for the service to be used; leave them empty to keep
# the interface in French, served from the cached translations only.
LANGUES229_API_URL=""
LANGUES229_API_KEY=""
LANGUES229_HF_TOKEN=""

# Base URL of the page metadata (Open Graph image and links). Defaults to
# http://localhost:3000.
NEXT_PUBLIC_APP_URL=""

# Demo account panel of the public sign in page (/connexion). In development
# it shows unless DEMO_MODE is "off". In a production build it shows only
# with "on" (a local production run), and never on the Vercel production
# deployment. Deployments offer the panel on the secret page below instead.
DEMO_MODE=""

# Secret demo sign in page: /acces/<DEMO_ACCESS_TOKEN> shows the sign in page
# with the demo account panel. At least 32 characters among letters, digits,
# "-" and "_" (openssl rand -hex 32). Empty: the page answers 404. Never
# publish it; on Vercel, store it as a Sensitive variable.
DEMO_ACCESS_TOKEN=""

# Shared password of the demo accounts, used by the seed, by
# scripts/set-demo-password.ts and prefilled by the secret page. Empty in
# development: the local fallback of src/lib/demo/password.ts is used. Empty
# in production: the seed refuses to run and the secret page lists the
# identifiers without a password. Never publish it; Sensitive on Vercel.
DEMO_PASSWORD=""

# "true" behind a reverse proxy other than Vercel that rewrites
# X-Forwarded-For: enables the per address limits (sign in, password help,
# public voice, document check). Leave empty otherwise, or anyone could
# forge an address.
TRUST_PROXY=""

# "true" behind an HTTPS proxy outside Vercel: secure cookies and HSTS.
# Leave empty for a plain HTTP run on a local network.
FORCE_HTTPS=""
