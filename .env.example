# PostgreSQL connection string. Local Docker: see docker-compose.yml.
# Neon: use the pooled connection string of your project.
DATABASE_URL="postgresql://classeo:classeo@localhost:55432/classeo"
# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=""

# Public address of the platform, used for the links inside e-mails.
APP_URL="http://localhost:3000"

# E-mail. Leave SMTP_HOST empty to send nothing: each e-mail is then only
# summarised in the server log (recipient masked, never the content).
# Local development with Mailpit (docker compose up -d mailpit, web UI on
# http://localhost:8025):
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
# Production: your provider's SMTP relay, port 587 (STARTTLS) or 465 with
# SMTP_SECURE=true.
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
MAIL_FROM="Classéo <no-reply@classeo.bj>"

# Web push notifications (VAPID). Leave empty to keep notifications in the
# app only. Generate a pair once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact of the operator, given to the push services: mailto: or https://
VAPID_SUBJECT=""
