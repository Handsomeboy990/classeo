// Classeo data model.
// The schema covers every roadmap wave (W1 core, W2 fees and timetable,
// W3 payroll and budgets) so that later waves add features, not migrations
// that conflict with work done in parallel.
// Money is stored as integer FCFA (XOF has no minor unit).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Territory
// ---------------------------------------------------------------------------

model Department {
  id       String    @id @default(cuid())
  code     String    @unique
  name     String    @unique
  communes Commune[]
  users    User[]
  contents Content[]
}

model Commune {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  schools      School[]
  users        User[]
  contents     Content[]

  @@unique([departmentId, name])
  @@index([departmentId])
}

enum SchoolSector {
  PUBLIC
  PRIVATE
  CONFESSIONAL
  COMMUNITY
}

enum SchoolCycle {
  PRESCHOOL
  PRIMARY
  SECONDARY
  TECHNICAL
}

// Marks and report cards by trimester or by semester (MESTFP order n° 029
// of 2024, articles 53 and 59). The holidays stay the same for everyone.
enum Periodicity {
  TRIMESTER
  SEMESTER
}

// Administrative chain: MEMP, DDEMP and circonscriptions for nursery and
// primary schools; MESTFP and DDESTFP for secondary schools.
enum EducationChain {
  PRIMARY
  SECONDARY
}

model School {
  id                String       @id @default(cuid())
  code              String       @unique
  name              String
  sector            SchoolSector
  cycle             SchoolCycle
  communeId         String
  commune           Commune      @relation(fields: [communeId], references: [id])
  address           String?
  phone             String?
  email             String?
  latitude          Float?
  longitude         Float?
  postalBox         String?
  website           String?
  motto             String?
  logoFileId        String?
  logo              FileBlob?    @relation("schoolLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  isActive          Boolean      @default(true)
  // Set by the ministry: semesters for public secondary schools, trimesters
  // elsewhere by default (lib/domain/periodicity.ts), overridable per school.
  periodicity       Periodicity  @default(TRIMESTER)
  // Compositions are a school practice, not the national rule: the grade
  // sheets offer them only when the school enables them.
  allowsComposition Boolean      @default(false)
  // Decided by the ministry chain: a suspended or closed school keeps its
  // history readable but accepts no new writes.
  status            SchoolStatus @default(ACTIVE)
  statusReason      String?
  statusChangedAt   DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  users                  User[]
  teachers               Teacher[]
  classrooms             Classroom[]
  enrollments            Enrollment[]
  contents               Content[]
  requests               SchoolRequest[]
  feeTypes               FeeType[]
  invoices               Invoice[]
  paymentPlans           PaymentPlan[]
  events                 SchoolEvent[]
  budgets                Budget[]
  expenses               Expense[]
  salaryGrids            SalaryGrid[]
  payrolls               Payroll[]
  paymentAccounts        SchoolPaymentAccount[]
  yearExtensions         YearExtension[]
  transfersOut           StudentTransfer[]      @relation("transferFrom")
  transfersIn            StudentTransfer[]      @relation("transferTo")
  recordGrants           StudentRecordAccess[]
  mockExamsOrganized     MockExam[]
  mockExamParticipations MockExamParticipant[]
  documentRequests       DocumentRequest[]
  subjectsRequested      Subject[]
  roles                  Role[]
  activeSessions         Session[]

  @@index([communeId])
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum PaymentChannel {
  MOBILE_MONEY
  BANK
}

// Where parents can pay the school electronically. Without at least one
// active account, online payment is not offered to parents.
model SchoolPaymentAccount {
  id            String         @id @default(cuid())
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  channel       PaymentChannel
  provider      String // "MTN MoMo", "Moov Money", "Celtiis Cash", bank name
  accountName   String
  accountNumber String // phone number or IBAN / RIB
  instructions  String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())

  @@index([schoolId])
}

// ---------------------------------------------------------------------------
// Identity, roles and permissions
// ---------------------------------------------------------------------------

// The territorial level a user acts at. It decides which rows their queries
// can reach, independently of which actions their role permits.
enum ScopeLevel {
  NATIONAL
  DEPARTMENT
  COMMUNE
  SCHOOL
  SELF
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique // "resource:action"
  resource    String
  action      String
  description String
  roles       RolePermission[]
}

model Role {
  id                String           @id @default(cuid())
  code              String           @unique
  name              String
  description       String
  scopeLevel        ScopeLevel
  isSystem          Boolean          @default(false)
  // A role created by a school (or a commune, a department) for its own
  // staff. Null: a national role available everywhere.
  ownerSchoolId     String?
  ownerSchool       School?          @relation(fields: [ownerSchoolId], references: [id], onDelete: Cascade)
  ownerCommuneId    String?
  ownerDepartmentId String?
  permissions       RolePermission[]
  users             User[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

enum Gender {
  F
  M
}

model User {
  id                 String          @id @default(cuid())
  // Sign in identifier generated from first and last name ("afiavi.hounkpatin",
  // then "afiavi.hounkpatin2"...). The e-mail is optional.
  username           String          @unique
  email              String?         @unique
  phone              String?
  passwordHash       String
  firstName          String
  lastName           String
  gender             Gender?
  roleId             String
  role               Role            @relation(fields: [roleId], references: [id])
  scopeLevel         ScopeLevel
  departmentId       String?
  department         Department?     @relation(fields: [departmentId], references: [id])
  communeId          String?
  commune            Commune?        @relation(fields: [communeId], references: [id])
  schoolId           String?
  school             School?         @relation(fields: [schoolId], references: [id])
  // For national and departmental accounts: the chain they belong to (a
  // DDEMP or a DDESTFP). Null reaches both chains.
  chain              EducationChain?
  isActive           Boolean         @default(true)
  mustChangePassword Boolean         @default(false)
  failedLoginCount   Int             @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  passwordResetTokens PasswordResetToken[]
  sessions            Session[]
  teachers            Teacher[]
  teacherProfile      TeacherProfile?
  signature           UserSignature?
  files               FileBlob[]                @relation("fileOwner")
  helpRequests        PasswordHelpRequest[]     @relation("helpRequester")
  helpHandled         PasswordHelpRequest[]     @relation("helpHandler")
  offlineSubmissions  OfflineSubmission[]
  documentSignatures  DocumentSignature[]
  student             Student?
  guardian            Guardian?
  auditLogs           AuditLog[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  contents            Content[]
  participations      ConversationParticipant[]
  messages            Message[]
  gradesEntered       Grade[]
  attendanceRecorded  StudentAttendance[]
  lockedSheets        GradeSheet[]
  publishedCards      ReportCard[]
  requestsFiled       SchoolRequest[]           @relation("requestAuthor")
  requestsDecided     SchoolRequest[]           @relation("requestDecider")
  paymentsRecorded    Payment[]

  @@index([roleId])
  @@index([schoolId])
  @@index([communeId])
  @@index([departmentId])
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // For accounts working in several schools (a teacher), the school chosen
  // for this session. Its rows are the only ones the scope reaches.
  activeSchoolId String?
  activeSchool   School?   @relation(fields: [activeSchoolId], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  revokedAt      DateTime?
  ip             String?
  userAgent      String?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

// Forgotten password: a 6 digit code sent by e-mail, stored only as a keyed
// hash, valid 15 minutes, 5 attempts, single use.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Fixed window counters for login and other abuse sensitive endpoints.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  summary    String
  metadata   Json?
  schoolId   String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([schoolId])
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model AcademicYear {
  id           String          @id @default(cuid())
  label        String          @unique // "2025-2026"
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean         @default(false)
  // Set by the ministry. After endDate (or once closedAt is set) the year is
  // read only everywhere, except for schools holding an open extension.
  closedAt     DateTime?
  extensions   YearExtension[]
  mockExams    MockExam[]
  periods      SchoolPeriod[]
  classrooms   Classroom[]
  enrollments  Enrollment[]
  feeTypes     FeeType[]
  paymentPlans PaymentPlan[]
  budgets      Budget[]
}

model SchoolPeriod {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String // "Trimestre 1", "Semestre 2"
  // Each year holds the three trimesters and the two semesters; a school
  // uses the set of its own periodicity.
  periodicity    Periodicity  @default(TRIMESTER)
  order          Int
  startDate      DateTime
  endDate        DateTime
  isClosed       Boolean      @default(false)
  gradeSheets    GradeSheet[]
  reportCards    ReportCard[]

  @@unique([academicYearId, periodicity, order])
}

model AcademicLevel {
  id         String      @id @default(cuid())
  code       String      @unique // "CI", "6E", "TLE"
  name       String
  cycle      SchoolCycle
  order      Int
  classrooms Classroom[]
  feeTypes   FeeType[]
}

enum SubjectStatus {
  APPROVED
  PENDING
  REJECTED
}

// The subject catalogue belongs to the ministry. A school proposes a subject
// (PENDING); once approved it becomes available to every school.
model Subject {
  id                  String             @id @default(cuid())
  code                String             @unique
  name                String
  status              SubjectStatus      @default(APPROVED)
  requestedBySchoolId String?
  requestedBySchool   School?            @relation(fields: [requestedBySchoolId], references: [id], onDelete: SetNull)
  decisionNote        String?
  assignments         CourseAssignment[]
}

// A teacher's appointment in one school. The same person teaching in two
// schools has two Teacher rows sharing one TeacherProfile and one account.
model Teacher {
  id          String              @id @default(cuid())
  userId      String?
  user        User?               @relation(fields: [userId], references: [id])
  profileId   String?
  profile     TeacherProfile?     @relation(fields: [profileId], references: [id])
  schoolId    String
  school      School              @relation(fields: [schoolId], references: [id])
  matricule   String              @unique
  firstName   String
  lastName    String
  gender      Gender?
  phone       String?
  specialty   String?
  hiredAt     DateTime?
  isActive    Boolean             @default(true)
  assignments CourseAssignment[]
  mainClasses Classroom[]
  attendances TeacherAttendance[]

  @@unique([userId, schoolId])
  @@index([schoolId])
  @@index([profileId])
}

// The person behind the appointments: found by NPI, phone or names before a
// school creates a new teacher, so nobody is registered twice.
model TeacherProfile {
  id        String    @id @default(cuid())
  userId    String?   @unique
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  npi       String?   @unique
  firstName String
  lastName  String
  gender    Gender?
  phone     String?
  email     String?
  createdAt DateTime  @default(now())
  teachers  Teacher[]

  @@index([phone])
  @@index([lastName, firstName])
}

model Classroom {
  id             String             @id @default(cuid())
  schoolId       String
  school         School             @relation(fields: [schoolId], references: [id])
  academicYearId String
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id])
  levelId        String
  level          AcademicLevel      @relation(fields: [levelId], references: [id])
  name           String // "6e A"
  capacity       Int                @default(60)
  mainTeacherId  String?
  mainTeacher    Teacher?           @relation(fields: [mainTeacherId], references: [id])
  enrollments    Enrollment[]
  assignments    CourseAssignment[]
  contents       Content[]

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId, academicYearId])
}

// A subject taught in a class by a teacher, with its coefficient.
model CourseAssignment {
  id          String          @id @default(cuid())
  classroomId String
  classroom   Classroom       @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject         @relation(fields: [subjectId], references: [id])
  teacherId   String?
  teacher     Teacher?        @relation(fields: [teacherId], references: [id])
  coefficient Int             @default(1)
  weeklyHours Int             @default(2)
  gradeSheets GradeSheet[]
  timetable   TimetableSlot[]

  @@unique([classroomId, subjectId])
  @@index([teacherId])
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

enum DisabilityType {
  VISUAL
  HEARING
  MOTOR
  COGNITIVE
}

model Student {
  id           String                @id @default(cuid())
  userId       String?               @unique
  user         User?                 @relation(fields: [userId], references: [id])
  matricule    String                @unique
  firstName    String
  lastName     String
  gender       Gender
  birthDate    DateTime
  birthPlace   String?
  disabilities DisabilityType[]
  photoFileId  String?
  photo        FileBlob?             @relation("studentPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  npi          String?               @unique
  createdAt    DateTime              @default(now())
  transfers    StudentTransfer[]
  recordAccess StudentRecordAccess[]
  guardians    StudentGuardian[]
  enrollments  Enrollment[]
}

enum ContactChannel {
  APP
  SMS
  VOICE_CALL
}

model Guardian {
  id               String            @id @default(cuid())
  userId           String?           @unique
  user             User?             @relation(fields: [userId], references: [id])
  firstName        String
  lastName         String
  phone            String
  profession       String?
  preferredChannel ContactChannel    @default(APP)
  prefersAudio     Boolean           @default(false)
  students         StudentGuardian[]
}

model StudentGuardian {
  studentId    String
  guardianId   String
  relationship String // "Mère", "Père", "Tuteur"
  isPrimary    Boolean  @default(false)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId])
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  WITHDRAWN
}

model Enrollment {
  id             String              @id @default(cuid())
  studentId      String
  student        Student             @relation(fields: [studentId], references: [id])
  schoolId       String
  school         School              @relation(fields: [schoolId], references: [id])
  classroomId    String
  classroom      Classroom           @relation(fields: [classroomId], references: [id])
  academicYearId String
  academicYear   AcademicYear        @relation(fields: [academicYearId], references: [id])
  status         EnrollmentStatus    @default(ACTIVE)
  isRepeating    Boolean             @default(false)
  enrolledAt     DateTime            @default(now())
  grades         Grade[]
  reportCards    ReportCard[]
  attendances    StudentAttendance[]
  invoices       Invoice[]

  @@unique([studentId, academicYearId])
  @@index([classroomId])
  @@index([schoolId, academicYearId])
}

// ---------------------------------------------------------------------------
// Evaluation
// ---------------------------------------------------------------------------

enum GradeFormula {
  OFFICIAL_2024 // order n° 029 of 2024: (interrogations average + each devoir surveillé) / number of marks
  WEIGHTED_STANDARD // school practice: (interrogations average + devoirs average + 2 x composition) / 4
  SIMPLE_AVERAGE
  COMPOSITION_ONLY
}

enum GradeType {
  INTERROGATION
  DEVOIR
  COMPOSITION
}

model GradeSheet {
  id                 String           @id @default(cuid())
  assignmentId       String
  assignment         CourseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  periodId           String
  period             SchoolPeriod     @relation(fields: [periodId], references: [id])
  formula            GradeFormula     @default(OFFICIAL_2024)
  interrogationCount Int              @default(2)
  devoirCount        Int              @default(2)
  compositionCount   Int              @default(0)
  isLocked           Boolean          @default(false)
  lockedAt           DateTime?
  lockedById         String?
  lockedBy           User?            @relation(fields: [lockedById], references: [id])
  grades             Grade[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([assignmentId, periodId])
}

model Grade {
  id           String     @id @default(cuid())
  gradeSheetId String
  gradeSheet   GradeSheet @relation(fields: [gradeSheetId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  type         GradeType
  sequence     Int
  value        Decimal    @db.Decimal(5, 2)
  maxValue     Decimal    @default(20) @db.Decimal(5, 2)
  comment      String?
  gradedById   String
  gradedBy     User       @relation(fields: [gradedById], references: [id])
  updatedAt    DateTime   @updatedAt

  @@unique([gradeSheetId, enrollmentId, type, sequence])
  @@index([enrollmentId])
}

// Snapshot taken when a report card is published, so that what a parent read
// on a given day stays what the school published.
model ReportCard {
  id             String       @id @default(cuid())
  enrollmentId   String
  enrollment     Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  periodId       String
  period         SchoolPeriod @relation(fields: [periodId], references: [id])
  generalAverage Decimal?     @db.Decimal(5, 2)
  rank           Int?
  classSize      Int
  appreciation   String?
  lines          Json // [{ subject, coefficient, average, rank }]
  publishedAt    DateTime     @default(now())
  publishedById  String
  publishedBy    User         @relation(fields: [publishedById], references: [id])

  @@unique([enrollmentId, periodId])
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum DayHalf {
  MORNING
  AFTERNOON
}

model StudentAttendance {
  id           String           @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date         DateTime         @db.Date
  half         DayHalf
  status       AttendanceStatus
  reason       String?
  recordedById String
  recordedBy   User             @relation(fields: [recordedById], references: [id])
  createdAt    DateTime         @default(now())

  @@unique([enrollmentId, date, half])
  @@index([date])
}

model TeacherAttendance {
  id        String           @id @default(cuid())
  teacherId String
  teacher   Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date      DateTime         @db.Date
  status    AttendanceStatus
  reason    String?

  @@unique([teacherId, date])
}

// ---------------------------------------------------------------------------
// Content and communication
// ---------------------------------------------------------------------------

enum ContentType {
  ANNOUNCEMENT
  RESOURCE
  EVENT
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Audience {
  EVERYONE
  PARENTS
  STUDENTS
  TEACHERS
  STAFF
}

enum MediaType {
  NONE
  AUDIO
  VIDEO
  DOCUMENT
  IMAGE
}

// Targeting: the most specific non null target wins. No target at all means
// national reach.
model Content {
  id           String        @id @default(cuid())
  type         ContentType
  title        String
  body         String
  easyRead     String? // short plain language summary, read aloud first
  audience     Audience      @default(EVERYONE)
  mediaType    MediaType     @default(NONE)
  mediaUrl     String?
  transcript   String? // mandatory when media is audio or video
  subjectLabel String?
  status       ContentStatus @default(DRAFT)
  // Shown as a scrolling band at the top of the screens it targets until
  // tickerUntil.
  ticker       Boolean       @default(false)
  tickerUntil  DateTime?
  publishedAt  DateTime?
  eventDate    DateTime?
  departmentId String?
  department   Department?   @relation(fields: [departmentId], references: [id])
  communeId    String?
  commune      Commune?      @relation(fields: [communeId], references: [id])
  schoolId     String?
  school       School?       @relation(fields: [schoolId], references: [id])
  classroomId  String?
  classroom    Classroom?    @relation(fields: [classroomId], references: [id])
  authorId     String
  author       User          @relation(fields: [authorId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([schoolId])
}

model Conversation {
  id           String                    @id @default(cuid())
  subject      String
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // "absence", "report_card", "message", "content", "request"
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// A browser or installed app that accepted web push for this user. One row
// per device; removed when the push service answers that it has expired.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

enum RequestType {
  YEAR_EXTENSION
  NEW_SUBJECT
  STAFFING
  INFRASTRUCTURE
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Requests a school files to the ministry chain (commune, department, nation).
model SchoolRequest {
  id           String        @id @default(cuid())
  schoolId     String
  school       School        @relation(fields: [schoolId], references: [id])
  type         RequestType
  subject      String
  body         String
  status       RequestStatus @default(PENDING)
  authorId     String
  author       User          @relation("requestAuthor", fields: [authorId], references: [id])
  deciderId    String?
  decider      User?         @relation("requestDecider", fields: [deciderId], references: [id])
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime      @default(now())

  @@index([schoolId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// W2: fees and payments
// ---------------------------------------------------------------------------

// What a fee is for: the rules of free schooling depend on it (the girls
// of public secondary schools are exempt from the contribution scolaire).
enum FeeKind {
  SCHOOL_CONTRIBUTION
  APE_DUES
  OTHER
}

model FeeType {
  id             String         @id @default(cuid())
  kind           FeeKind        @default(OTHER)
  schoolId       String
  school         School         @relation(fields: [schoolId], references: [id])
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id])
  levelId        String?
  level          AcademicLevel? @relation(fields: [levelId], references: [id])
  name           String
  amount         Int
  isActive       Boolean        @default(true)
  items          InvoiceItem[]
  plans          PaymentPlan[]
}

model PaymentPlan {
  id             String                   @id @default(cuid())
  schoolId       String
  school         School                   @relation(fields: [schoolId], references: [id])
  academicYearId String
  academicYear   AcademicYear             @relation(fields: [academicYearId], references: [id])
  feeTypeId      String
  feeType        FeeType                  @relation(fields: [feeTypeId], references: [id])
  name           String
  isActive       Boolean                  @default(true)
  installments   PaymentPlanInstallment[]
}

model PaymentPlanInstallment {
  id      String      @id @default(cuid())
  planId  String
  plan    PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  label   String
  order   Int
  percent Int // share of the fee, the plan sums to 100
  dueDate DateTime
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id           String               @id @default(cuid())
  number       String               @unique
  schoolId     String
  school       School               @relation(fields: [schoolId], references: [id])
  enrollmentId String
  enrollment   Enrollment           @relation(fields: [enrollmentId], references: [id])
  totalAmount  Int
  paidAmount   Int                  @default(0)
  status       InvoiceStatus        @default(PENDING)
  issueDate    DateTime
  dueDate      DateTime
  items        InvoiceItem[]
  installments InvoiceInstallment[]
  payments     Payment[]
  declarations PaymentDeclaration[]
  createdAt    DateTime             @default(now())

  @@index([schoolId, status])
  @@index([enrollmentId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeTypeId   String?
  feeType     FeeType? @relation(fields: [feeTypeId], references: [id])
  description String
  quantity    Int      @default(1)
  unitPrice   Int
}

model InvoiceInstallment {
  id         String        @id @default(cuid())
  invoiceId  String
  invoice    Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label      String
  order      Int
  amount     Int
  paidAmount Int           @default(0)
  dueDate    DateTime
  status     InvoiceStatus @default(PENDING)
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CHEQUE
}

model Payment {
  id            String        @id @default(cuid())
  reference     String        @unique
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  amount        Int
  method        PaymentMethod
  transactionId String?
  paidAt        DateTime
  recordedById  String
  recordedBy    User          @relation(fields: [recordedById], references: [id])
  createdAt     DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// W2: timetable
// ---------------------------------------------------------------------------

model TimetableSlot {
  id           String               @id @default(cuid())
  assignmentId String
  assignment   CourseAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  dayOfWeek    Int // 1 = Monday
  startTime    String // "08:00"
  endTime      String
  room         String?
  exceptions   TimetableException[]

  @@index([assignmentId])
}

model TimetableException {
  id     String        @id @default(cuid())
  slotId String
  slot   TimetableSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  date   DateTime      @db.Date
  kind   String // "CANCELLED", "MOVED"
  note   String?
}

model SchoolEvent {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
}

// ---------------------------------------------------------------------------
// W3: payroll, budgets, expenses (roadmap, schema reserved)
// ---------------------------------------------------------------------------

model SalaryGrid {
  id         String    @id @default(cuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id])
  name       String
  baseAmount Int
  payrolls   Payroll[]
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

model Payroll {
  id           String        @id @default(cuid())
  schoolId     String
  school       School        @relation(fields: [schoolId], references: [id])
  salaryGridId String?
  salaryGrid   SalaryGrid?   @relation(fields: [salaryGridId], references: [id])
  employeeName String
  month        String // "2026-01"
  grossAmount  Int
  netAmount    Int
  status       PayrollStatus @default(DRAFT)
}

model Budget {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  category       String
  plannedAmount  Int
  isApproved     Boolean      @default(false)
}

model Expense {
  id       String   @id @default(cuid())
  schoolId String
  school   School   @relation(fields: [schoolId], references: [id])
  category String
  label    String
  amount   Int
  spentAt  DateTime
}

// ---------------------------------------------------------------------------
// V3: files, signatures, transfers, mock exams, governance, offline sync
// ---------------------------------------------------------------------------

// Small uploaded files kept in the database (photos, logos, signatures,
// stamps, requested documents): no third party storage, served through an
// authorized route. Images are resized on the client before upload.
model FileBlob {
  id          String   @id @default(cuid())
  ownerUserId String?
  owner       User?    @relation("fileOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  purpose     String // "student_photo", "school_logo", "signature", "stamp", "document", "payment_proof"
  fileName    String
  mimeType    String
  size        Int
  sha256      String
  data        Bytes
  createdAt   DateTime @default(now())

  studentPhotos Student[]             @relation("studentPhoto")
  schoolLogos   School[]              @relation("schoolLogo")
  signatures    UserSignature[]       @relation("signatureImage")
  stamps        UserSignature[]       @relation("stampImage")
  documentFiles DocumentRequestFile[]
  paymentProofs PaymentDeclaration[]

  @@index([ownerUserId])
}

// A signer's handwritten signature and the stamp of their office, uploaded or
// drawn once, applied to the documents they sign.
model UserSignature {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  signatureFileId String?
  signature       FileBlob? @relation("signatureImage", fields: [signatureFileId], references: [id], onDelete: SetNull)
  stampFileId     String?
  stamp           FileBlob? @relation("stampImage", fields: [stampFileId], references: [id], onDelete: SetNull)
  updatedAt       DateTime  @updatedAt
}

// A document signed electronically: the reference printed on it, the hash of
// its content and the signer, so anyone can verify it online.
model DocumentSignature {
  id          String    @id @default(cuid())
  reference   String    @unique
  kind        String // "attestation", "bulletin", "certificate", "transfer"
  subjectId   String // student, report card or transfer id
  contentHash String
  signedById  String
  signedBy    User      @relation(fields: [signedById], references: [id])
  schoolId    String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([subjectId])
}

enum TransferKind {
  CLASS_CHANGE
  SCHOOL_CHANGE
}

enum TransferStatus {
  PENDING_GUARDIAN
  PENDING_DESTINATION
  ACCEPTED
  REJECTED
  CANCELLED
}

// A pupil moving to another class of the same school, or to another school.
// A school change needs the guardian's consent, then the destination
// school's acceptance; the history travels only if the guardian agreed.
model StudentTransfer {
  id                   String         @id @default(cuid())
  studentId            String
  student              Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind                 TransferKind
  fromSchoolId         String
  fromSchool           School         @relation("transferFrom", fields: [fromSchoolId], references: [id])
  fromClassroomId      String
  toSchoolId           String
  toSchool             School         @relation("transferTo", fields: [toSchoolId], references: [id])
  toClassroomId        String?
  reason               String
  shareHistory         Boolean        @default(true)
  status               TransferStatus
  requestedById        String
  guardianDecisionById String?
  guardianDecidedAt    DateTime?
  decidedById          String?
  decidedAt            DateTime?
  decisionNote         String?
  createdAt            DateTime       @default(now())

  @@index([studentId])
  @@index([toSchoolId, status])
  @@index([fromSchoolId, status])
}

// A school allowed to read a pupil's history held by other schools (after a
// transfer, or a record request approved by the guardian).
model StudentRecordAccess {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grantedById String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([studentId, schoolId])
}

enum OrganizerLevel {
  SCHOOL
  COMMUNE
  DEPARTMENT
  NATIONAL
}

enum MockExamStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CLOSED
}

enum ParticipationStatus {
  INVITED
  ACCEPTED
  DECLINED
  IMPOSED
}

// A mock examination (examen blanc) for an exam class. A school organises it
// with invited schools that accept or decline, then the hierarchy approves;
// when a commune, a department or the ministry organises it, participation
// is imposed.
model MockExam {
  id                    String                @id @default(cuid())
  title                 String
  levelId               String
  academicYearId        String
  academicYear          AcademicYear          @relation(fields: [academicYearId], references: [id])
  organizerLevel        OrganizerLevel
  organizerSchoolId     String?
  organizerSchool       School?               @relation(fields: [organizerSchoolId], references: [id])
  organizerCommuneId    String?
  organizerDepartmentId String?
  createdById           String
  startDate             DateTime
  endDate               DateTime
  subjects              String[] // subject codes
  status                MockExamStatus        @default(DRAFT)
  decidedById           String?
  decidedAt             DateTime?
  decisionNote          String?
  createdAt             DateTime              @default(now())
  participants          MockExamParticipant[]
  results               MockExamResult[]
}

model MockExamParticipant {
  id            String              @id @default(cuid())
  examId        String
  exam          MockExam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  schoolId      String
  school        School              @relation(fields: [schoolId], references: [id])
  status        ParticipationStatus
  respondedAt   DateTime?
  respondedById String?

  @@unique([examId, schoolId])
}

model MockExamResult {
  id           String   @id @default(cuid())
  examId       String
  exam         MockExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  enrollmentId String
  subjectCode  String
  score        Decimal  @db.Decimal(5, 2)
  enteredById  String
  updatedAt    DateTime @updatedAt

  @@unique([examId, enrollmentId, subjectCode])
}

enum ExtensionStatus {
  ACTIVE
  ENDED
}

// The ministry keeps a closed year open for all schools (schoolId null) or
// for some, until a date. Created directly or by approving a school request.
model YearExtension {
  id             String          @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id])
  schoolId       String?
  school         School?         @relation(fields: [schoolId], references: [id])
  until          DateTime
  reason         String
  status         ExtensionStatus @default(ACTIVE)
  grantedById    String
  requestId      String?
  createdAt      DateTime        @default(now())

  @@index([academicYearId, schoolId])
}

enum DocumentRequestStatus {
  PENDING
  SUBMITTED
  ACCEPTED
  REJECTED
}

// Pieces the ministry, a department or a commune asks a school to provide
// (reports, certificates, inventories), answered by uploading files.
model DocumentRequest {
  id            String                @id @default(cuid())
  schoolId      String
  school        School                @relation(fields: [schoolId], references: [id])
  title         String
  description   String
  dueDate       DateTime?
  requestedById String
  status        DocumentRequestStatus @default(PENDING)
  responseNote  String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime              @default(now())
  files         DocumentRequestFile[]

  @@index([schoolId, status])
}

model DocumentRequestFile {
  id           String          @id @default(cuid())
  requestId    String
  request      DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileId       String
  file         FileBlob        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedById String
  createdAt    DateTime        @default(now())
}

enum DeclarationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// A payment made by a parent outside the cash desk (Mobile Money, bank
// transfer) to one of the school's accounts: declared with its transaction
// reference, confirmed by the accountant, which records the actual Payment.
model PaymentDeclaration {
  id             String            @id @default(cuid())
  invoiceId      String
  invoice        Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  accountId      String?
  amount         Int
  method         PaymentMethod
  payerPhone     String?
  transactionRef String
  proofFileId    String?
  proof          FileBlob?         @relation(fields: [proofFileId], references: [id], onDelete: SetNull)
  status         DeclarationStatus @default(PENDING)
  declaredById   String
  decidedById    String?
  decidedAt      DateTime?
  note           String?
  paymentId      String?
  createdAt      DateTime          @default(now())

  @@unique([invoiceId, transactionRef])
  @@index([status])
}

enum HelpStatus {
  PENDING
  RESOLVED
  REJECTED
}

// Forgotten password without e-mail: the request goes to the administration
// one level up (school for pupils, parents and teachers; commune for school
// heads; department for communes; ministry for departments), which resets it.
model PasswordHelpRequest {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation("helpRequester", fields: [userId], references: [id], onDelete: Cascade)
  status      HelpStatus @default(PENDING)
  contact     String?
  handledById String?
  handler     User?      @relation("helpHandler", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt   DateTime?
  note        String?
  createdAt   DateTime   @default(now())

  @@index([status])
}

// Writes made offline and replayed later: the client id makes a replay
// idempotent, the status tells the device what happened.
model OfflineSubmission {
  id        String   @id @default(cuid())
  clientId  String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // "grades", "attendance", "message"
  status    String // "applied", "rejected"
  error     String?
  createdAt DateTime @default(now())
}

// Translations of interface and content strings into Beninese languages,
// fetched once from the translation service (rate limited) and reused.
model Translation {
  id        String   @id @default(cuid())
  key       String // sha256 of the source text
  lang      String // "fon", "yo", "bab", "adj", "ee", "ha"
  source    String
  text      String
  createdAt DateTime @default(now())

  @@unique([key, lang])
}

// ---------------------------------------------------------------------------
// V3.1: issued documents, online payments, feature flags
// ---------------------------------------------------------------------------

// Every document the platform generates (report card, attestation, receipt,
// invoice, certificate, list, statistics...) gets a unique reference and the
// hash of its content. The QR code printed on it points to the public check
// page. A signed document also links its signature.
model IssuedDocument {
  id            String    @id @default(cuid())
  reference     String    @unique
  kind          String // "bulletin", "attestation", "recu", "facture", "certificat", "liste", "statistiques", "emploi_du_temps", "releve", "fiche_appel"
  title         String
  subjectId     String? // student, report card, payment, invoice or transfer id
  schoolId      String?
  contentHash   String
  issuedById    String
  signatureId   String?   @unique
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())

  @@index([subjectId])
  @@index([schoolId, createdAt])
}

enum OnlinePaymentStatus {
  CREATED
  PENDING
  APPROVED
  DECLINED
  CANCELED
  REFUNDED
}

// A payment started online with an aggregator (FedaPay today; TrésorPay or
// another provider later). The provider's webhook, verified by signature,
// moves it to APPROVED, which records the Payment on the invoice once.
model OnlinePayment {
  id             String              @id @default(cuid())
  provider       String // "fedapay"
  providerRef    String?             @unique
  invoiceId      String
  installmentIds String[]
  amount         Int
  currency       String              @default("XOF")
  status         OnlinePaymentStatus @default(CREATED)
  checkoutUrl    String?
  payerId        String
  payerPhone     String?
  paymentId      String?             @unique
  lastEvent      Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([invoiceId])
  @@index([status])
}

// Options a super administrator turns on or off, or configures, without a
// deployment (payment provider, modules, local languages, limits). Read
// through src/lib/features.ts, cached, with a code default for every key.
model FeatureFlag {
  key         String   @id
  enabled     Boolean
  config      Json?
  description String
  updatedById String?
  updatedAt   DateTime @updatedAt
}
